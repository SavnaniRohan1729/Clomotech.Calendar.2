<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="SampleApp.Views.CalendarPickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleApp.ViewModels"
    xmlns:plugin="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
    xmlns:styles="clr-namespace:Plugin.Maui.Calendar.Styles;assembly=Plugin.Maui.Calendar"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:CalendarPickerPopupViewModel"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Size="320,580"
    Color="Transparent">

    <toolkit:Popup.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="5" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource ButtonColor}" />
            </Style>
            <Style
                x:Key="MyDaysTitleLabelStyle"
                BasedOn="{x:Static styles:DefaultStyles.DefaultDaysTitleLabelStyle}"
                TargetType="Label">
                <Setter Property="TextColor" Value="{toolkit:AppThemeResource DaysTitleLabelTextColor}" />
            </Style>
            <Style
                x:Key="MyWeekendTitleStyle"
                BasedOn="{x:Static styles:DefaultStyles.DefaultWeekendTitleStyle}"
                TargetType="Label">
                <Setter Property="TextColor" Value="{toolkit:AppThemeResource DaysTitleLabelTextColor}" />
            </Style>
        </ResourceDictionary>
    </toolkit:Popup.Resources>

    <toolkit:Popup.BindingContext>
        <local:CalendarPickerPopupViewModel />
    </toolkit:Popup.BindingContext>

    <Border
        Margin="20"
        BackgroundColor="{toolkit:AppThemeResource PopupBackgroundColor}"
        HorizontalOptions="Center"
        StrokeShape="RoundRectangle 6"
        VerticalOptions="Center">
        <VerticalStackLayout IsClippedToBounds="True" Spacing="3">
            <Label
                FontAttributes="Bold"
                FontSize="Large"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                Text="Choose Date"
                VerticalOptions="Center" />
            <plugin:Calendar
                x:Name="calendar"
                Padding="10,0"
                DaysTitleLabelStyle="{StaticResource MyDaysTitleLabelStyle}"
                DeselectedDayTextColor="{toolkit:AppThemeResource DeselectedDayLabelTextColor}"
                DisabledDayColor="Gray"
                FooterSectionVisible="False"
                HorizontalOptions="Center"
                MaximumDate="{Binding MaximumDate}"
                MinimumDate="{Binding MinimumDate}"
                SelectedDate="{Binding SelectedDate}"
                VerticalOptions="Center"
                WeekendTitleStyle="{StaticResource MyWeekendTitleStyle}"
                WidthRequest="320" />
            <Grid
                Margin="5"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Command="{Binding ClearCommand}"
                    Text="Clear" />
                <Button
                    Grid.Column="1"
                    Command="{Binding SuccessCommand}"
                    Text="Select" />
                <Button
                    Grid.Column="2"
                    Command="{Binding CancelCommand}"
                    Text="Cancel" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>